  "structures": [
    {
      "id": "pas-juste",
      "regex": "(?i)\\bce n['’]?est pas (?:juste|seulement|simplement|que|qu['’]une?)\\b[^.!?\\n]{2,60}[,.;]\\s*c['’]est\\b",
      "name": "« Ce n'est pas juste X, c'est Y »",
      "fix": "Dites la seule chose que vous pensez vraiment. Supprimez la première moitié."
    },
    {
      "id": "non-seulement",
      "regex": "(?i)\\bnon seulement\\b[^.!?\\n]{2,80}\\bmais (?:aussi|également|encore)\\b",
      "name": "« Non seulement X mais aussi Y »",
      "fix": "Deux phrases, ou gardez la moitié la plus forte."
    },
    {
      "id": "il-sagit",
      "regex": "(?i)\\bil ne s['’]agit pas (?:de|d['’]|seulement|que)[^.!?\\n]{2,60}[.,;]\\s*il s['’]agit\\b",
      "name": "« Il ne s'agit pas de X. Il s'agit de Y. »",
      "fix": "Commencez par Y. Le retournement est le tic."
    },
    {
      "id": "le-resultat",
      "regex": "(?im)^\\s*(?:le résultat|la suite|le pire|le meilleur|la vérité|la clé|le secret|la réponse)\\s*\\?\\s*$",
      "name": "« Le résultat ? » seul sur sa ligne",
      "fix": "Donnez le résultat directement."
    },
    {
      "id": "voici-ce-que",
      "regex": "(?i)\\bvoici ce que (?:j['’]ai|nous avons) appris\\b",
      "name": "« Voici ce que j'ai appris »",
      "fix": "Commencez par la leçon elle-même."
    },
    {
      "id": "triade",
      "regex": "(?i)\\b\\w+, \\w+ et \\w+\\.",
      "name": "Triade « X, Y et Z. »",
      "fix": "Gardez les deux éléments qui comptent, ou ajoutez-en un quatrième précis."
    },
    {
      "id": "palpable",
      "regex": "(?i)\\b(?:était|est|étaient) palpable\\b|\\bvraie révélation\\b|\\bvéritable révolution\\b",
      "name": "Emphase de brochure (« palpable », « vraie révélation »)",
      "fix": "Racontez ce qui s'est passé, avec un détail."
    },
    {
      "id": "en-tant-qu-ia",
      "regex": "(?i)\\ben tant qu['’](?:IA|intelligence artificielle)\\b|\\ben tant que modèle de langage\\b",
      "name": "« En tant qu'IA »",
      "fix": "Supprimez."
    },
    {
      "id": "en-resume",
      "regex": "(?im)^\\s*(?:en résumé|pour résumer|en conclusion|pour conclure)\\b",
      "name": "« En résumé / En conclusion »",
      "fix": "La dernière ligne doit se suffire à elle-même."
    },
    {
      "id": "appat",
      "regex": "(?i)(?:qu['’]en pensez-vous|vous en pensez quoi|et vous \\?|d['’]accord \\?|j['’]ai tort \\?)\\s*\\??\\s*$",
      "name": "Question d'appât générique",
      "fix": "Posez une question précise sur le sujet du post."
    },
    {
      "id": "rocket",
      "regex": "[\\U0001F680\\U0001F525\\U0001F4A1\\u2728\\U0001F3AF]",
      "name": "Rocket / fire / bulb / sparkle / dart emoji",
      "fix": "One emoji max, and not one of these five."
    },
    {
      "id": "hashtag-wall",
      "regex": "(?:#\\w+[ \\t]*){5,}",
      "name": "Hashtag wall (5+)",
      "fix": "Three hashtags. LinkedIn stopped rewarding the wall."
    }
  ]
